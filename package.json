{
  "name": "dp-pi-extensions",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run check:root && bun run --workspaces check",
    "check:root": "bun run format:check && bun run lint && bun run typecheck && bun run test:skills",
    "test": "bun test",
    "test:skills": "bun test ./tests/skills.test.mjs",
    "test:pi-skills": "bun run ./tests/pi-skills-smoke.mjs",
    "format": "bun run --bun oxfmt .",
    "format:check": "bun run --bun oxfmt --check .",
    "lint": "bun run --bun oxlint .",
    "lint:fix": "bun run --bun oxlint --fix .",
    "typecheck": "bun run --bun tsc --noEmit",
    "lsp": "bun run --bun typescript-language-server --stdio"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^24.12.4",
    "@types/proper-lockfile": "^4.1.4",
    "bun-types": "1.4.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./extensions/question/index.ts",
      "./extensions/fast-mode/index.ts",
      "./extensions/router/index.ts",
      "./extensions/usage/index.ts",
      "./extensions/web-tools/index.ts",
      "./extensions/mcp/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ]
}
