{
  "name": "pi-router",
  "version": "0.1.0",
  "private": true,
  "description": "Native Pi multi-account login and usage routing",
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "format:check": "bun run --bun oxfmt --check .",
    "lint": "bun run --bun oxlint --deny-warnings --tsconfig tsconfig.json .",
    "typecheck": "bun run --bun tsc --noEmit",
    "test": "bun test ./tests"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": ">=0.85.1"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
