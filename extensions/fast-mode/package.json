{
  "name": "pi-fast-mode",
  "version": "0.1.0",
  "private": true,
  "description": "Global Codex Fast mode toggle for Pi",
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "format": "bun run --bun oxfmt --write .",
    "format:check": "bun run --bun oxfmt --check .",
    "lint": "bun run --bun oxlint --deny-warnings --tsconfig tsconfig.json .",
    "lint:fix": "bun run lint --fix",
    "typecheck": "bun run --bun tsc --noEmit",
    "test": "bun test ./tests"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^24.12.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.2",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
