{
  "name": "pi-context",
  "version": "0.1.0",
  "private": true,
  "description": "Local notes, branch-aware recall, and verified fresh context windows for Pi",
  "keywords": [
    "context",
    "pi-extension",
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --tsconfig tsconfig.json *.ts tests",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^24.12.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
