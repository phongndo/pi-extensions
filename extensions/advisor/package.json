{
  "name": "pi-advisor",
  "version": "0.1.0",
  "private": true,
  "description": "Advisor tool for Pi: the working model consults a stronger model that sees its full transcript",
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "format": "bun run --bun oxfmt --write .",
    "format:check": "bun run --bun oxfmt --check .",
    "lint": "bun run --bun oxlint --deny-warnings --tsconfig tsconfig.json .",
    "lint:fix": "bun run lint --fix",
    "typecheck": "bun run --bun tsc --noEmit",
    "test": "bun test ./tests"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^24.12.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.2",
    "@earendil-works/pi-coding-agent": ">=1.5.2",
    "@earendil-works/pi-tui": ">=1.5.2",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.2",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
