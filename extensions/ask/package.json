{
  "name": "pi-ask",
  "version": "0.1.0",
  "private": true,
  "description": "Native interactive clarification tool for Pi",
  "keywords": [
    "ask",
    "pi-extension",
    "pi-package",
    "user-input"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --tsconfig tsconfig.json .",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/node": "^24.12.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.17.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
