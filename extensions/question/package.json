{
  "name": "pi-question",
  "version": "0.1.0",
  "private": true,
  "description": "Native interactive clarification tool for Pi",
  "keywords": [
    "pi-extension",
    "pi-package",
    "question",
    "user-input"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "format": "bun run --bun oxfmt --write .",
    "format:check": "bun run --bun oxfmt --check .",
    "lint": "bun run --bun oxlint --deny-warnings --tsconfig tsconfig.json .",
    "lint:fix": "bun run lint --fix",
    "typecheck": "bun run --bun tsc --noEmit",
    "test": "bun test ./tests"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/node": "^24.12.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.2",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
