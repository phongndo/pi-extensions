{
  "name": "pi-web-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded Firecrawl search, map, fetch, crawl, and extract tools for Pi",
  "keywords": [
    "firecrawl",
    "pi-extension",
    "pi-package",
    "web"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "typecheck": "bun run --bun tsc --noEmit",
    "lint": "bun run --bun oxlint --deny-warnings --tsconfig tsconfig.json index.ts tests",
    "lint:fix": "bun run lint --fix",
    "format": "bun run --bun oxfmt --write .",
    "format:check": "bun run --bun oxfmt --check .",
    "lsp": "bun run --bun typescript-language-server --stdio",
    "lsp:oxformat": "bun run --bun oxfmt --lsp",
    "lsp:oxlint": "bun run --bun oxlint --lsp",
    "test": "bun test ./tests"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "^26.1.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
