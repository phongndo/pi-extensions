{
  "name": "pi-web-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded Firecrawl search, map, fetch, crawl, and extract tools for Pi",
  "keywords": [
    "firecrawl",
    "pi-extension",
    "pi-package",
    "web"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --tsconfig tsconfig.json index.ts tests",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lsp": "typescript-language-server --stdio",
    "lsp:oxformat": "oxfmt --lsp",
    "lsp:oxlint": "oxlint --lsp",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "^26.1.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
