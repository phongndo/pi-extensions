diff --git a/src/speed-config.ts b/src/speed-config.ts
new file mode 100644
index 0000000..7da3d07
--- /dev/null
+++ b/src/speed-config.ts
@@ -0,0 +1,94 @@
+/**
+ * Claude Code's fast mode, chosen per pi call through pi's `onPayload` hook.
+ *
+ * This provider sends no HTTP request of its own, so its "payload" is the
+ * launch it asks of the CLI: `{ model }`. pi passes it through its
+ * `onPayload` hook (and so `before_provider_request` handlers) before every
+ * call; a hook that returns `speed: "fast"` asks for fast mode, the field
+ * Anthropic's Messages API uses for the same thing. Every other field of the
+ * returned payload is ignored but one: `usageCredits: "allow"` beside
+ * `speed: "fast"` consents to fast mode's usage-credit charge, so the
+ * usage-credit guard lets that call through. A hook that sets only `speed`
+ * gets fast mode with the guard still on. (pi-extensions' Fast Mode sets
+ * both, because `/fast` is the user's consent.)
+ *
+ * Fast mode is a launch setting (`--settings '{"fastMode":true}'`, the form
+ * Claude Code documents for `-p`) and part of the launch signature, so a
+ * change of speed retires the parked process and the next call imports pi's
+ * history into a fresh one. Fast and standard requests keep separate prompt
+ * caches on Anthropic's side, so nothing is lost that a switch keeps.
+ *
+ * The models Claude Code documents fast mode for advertise it as model
+ * metadata, `serviceTiers: [{ id: "fast" }]`, the shape speed policies read;
+ * every other model advertises none, and asking for fast on it is standard.
+ * Claude Code still decides whether fast mode applies: a disabled
+ * organization or exhausted usage credits run at standard speed. On a
+ * subscription, fast mode is always billed to usage credits.
+ *
+ * Pure and free of Effect imports.
+ */
+
+/** The speed one pi call asks the CLI for. */
+export type CliSpeed = "standard" | "fast";
+
+/** What this provider passes to pi's `onPayload` hook. */
+export interface LaunchPayload {
+  readonly model: string;
+  readonly speed?: "fast";
+  readonly usageCredits?: "allow";
+}
+
+/** What one pi call asks of its CLI launch. */
+export interface LaunchRequest {
+  readonly speed: CliSpeed;
+  /** True when the call consented to fast mode's usage-credit charge. */
+  readonly usageCreditConsent: boolean;
+}
+
+/** A call no hook asked anything of. */
+export const STANDARD_LAUNCH: LaunchRequest = { speed: "standard", usageCreditConsent: false };
+
+/**
+ * Claude Code's fast-mode models (code.claude.com/docs/en/fast-mode). Opus
+ * 4.8 is left out: its fast mode is removed on 2026-11-30.
+ */
+const FAST_MODE_MODELS: ReadonlySet<string> = new Set([
+  "claude-fable-5-2",
+  "claude-opus-5-5",
+  "claude-opus-5",
+]);
+
+/** One speed a model offers beyond standard, as model metadata. */
+export interface ServiceTier {
+  readonly id: "fast";
+}
+
+/** The speeds `modelId` offers beyond standard: fast, or none. */
+export function serviceTiers(modelId: string): ServiceTier[] {
+  return FAST_MODE_MODELS.has(modelId) ? [{ id: "fast" }] : [];
+}
+
+/** The payload pi's hooks see for a call on `modelId`, before any hook ran. */
+export const launchPayload = (modelId: string): LaunchPayload => ({ model: modelId });
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+
+/**
+ * What a hook's result asks for on `modelId`: fast only for `speed: "fast"`
+ * on a model that offers it, and consent to its usage-credit charge only
+ * with `usageCredits: "allow"` on such a fast launch.
+ */
+export function launchRequest(payload: unknown, modelId: string): LaunchRequest {
+  if (!isRecord(payload) || payload["speed"] !== "fast" || serviceTiers(modelId).length === 0)
+    return STANDARD_LAUNCH;
+  return { speed: "fast", usageCreditConsent: payload["usageCredits"] === "allow" };
+}
+
+/**
+ * CLI flags for a spawn at `speed`. Standard adds nothing: the CLI reads no
+ * user settings (`--setting-sources ""`), so fast mode is off unless asked.
+ */
+export function speedSpawnArgs(speed: CliSpeed): string[] {
+  return speed === "fast" ? ["--settings", JSON.stringify({ fastMode: true })] : [];
+}
