diff --git a/tests/speed-config.test.ts b/tests/speed-config.test.ts
new file mode 100644
index 0000000..5a15e9b
--- /dev/null
+++ b/tests/speed-config.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, it } from "vite-plus/test";
+import {
+  launchPayload,
+  launchRequest,
+  serviceTiers,
+  speedSpawnArgs,
+  STANDARD_LAUNCH,
+} from "../src/speed-config";
+
+describe("the launch payload pi's onPayload hook sees", () => {
+  it("names the model and asks for no speed", () => {
+    expect(launchPayload("claude-opus-5-5")).toEqual({ model: "claude-opus-5-5" });
+  });
+
+  it("is fast only when a hook returns speed: fast", () => {
+    const opus = "claude-opus-5-5";
+    const fast = { speed: "fast", usageCreditConsent: false };
+    expect(launchRequest({ model: opus, speed: "fast" }, opus)).toEqual(fast);
+    expect(launchRequest({ model: opus }, opus)).toEqual(STANDARD_LAUNCH);
+    expect(launchRequest({ model: opus, speed: "ultrafast" }, opus)).toEqual(STANDARD_LAUNCH);
+    expect(launchRequest({ model: opus, speed: true }, opus)).toEqual(STANDARD_LAUNCH);
+    expect(launchRequest(undefined, opus)).toEqual(STANDARD_LAUNCH);
+    expect(launchRequest(["fast"], opus)).toEqual(STANDARD_LAUNCH);
+  });
+
+  it("consents to usage credits only on a fast launch that says so", () => {
+    const opus = "claude-opus-5-5";
+    expect(launchRequest({ speed: "fast", usageCredits: "allow" }, opus)).toEqual({
+      speed: "fast",
+      usageCreditConsent: true,
+    });
+    expect(launchRequest({ usageCredits: "allow" }, opus)).toEqual(STANDARD_LAUNCH);
+    expect(launchRequest({ speed: "fast", usageCredits: true }, opus).usageCreditConsent).toBe(
+      false,
+    );
+  });
+
+  it("is standard on a model without fast mode, whatever the hook asks", () => {
+    expect(launchRequest({ speed: "fast", usageCredits: "allow" }, "claude-haiku-4-5")).toEqual(
+      STANDARD_LAUNCH,
+    );
+  });
+});
+
+describe("the speeds a model advertises", () => {
+  it("offers fast on Claude Code's fast-mode models only", () => {
+    for (const id of ["claude-fable-5-2", "claude-opus-5-5", "claude-opus-5"])
+      expect(serviceTiers(id)).toEqual([{ id: "fast" }]);
+    for (const id of [
+      "claude-opus-4-8",
+      "claude-sonnet-5-5",
+      "claude-haiku-4-5",
+      "claude-opus-5-5-x",
+    ])
+      expect(serviceTiers(id)).toEqual([]);
+  });
+});
+
+describe("speed launch flags", () => {
+  it("turns fast mode on through the documented --settings form", () => {
+    expect(speedSpawnArgs("fast")).toEqual(["--settings", '{"fastMode":true}']);
+  });
+
+  it("adds nothing at standard speed", () => {
+    expect(speedSpawnArgs("standard")).toEqual([]);
+  });
+});
